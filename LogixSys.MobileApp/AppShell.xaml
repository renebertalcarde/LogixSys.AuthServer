<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LogixSys.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LogixSys.MobileApp"
    xmlns:views="clr-namespace:LogixSys.MobileApp.Views"
    Title="LogixSys.MobileApp">

    <ShellContent
        Title="HRMobile"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Profile"
        ContentTemplate="{DataTemplate views:ProfilePage}"
        Route="ProfilePage" />

</Shell>
