<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogixSys.MobileApp.Views.ProfilePage"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="StatusLabel" Text="Loading..." FontAttributes="Bold" />
            <Label Text="Claims:" FontAttributes="Bold" />
            <CollectionView x:Name="ClaimsList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Key}" FontAttributes="Bold" />
                            <Label Text=":" />
                            <Label Text="{Binding Value}" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="LogoutButton" Text="Log out" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
