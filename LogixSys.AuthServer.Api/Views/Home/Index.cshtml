@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <h1>Welcome</h1>

    <p>
        You are successfully authenticated.
    </p>

    <hr />

    <dl>
        <dt>Name</dt>
        <dd>@User.Identity?.Name</dd>

        <dt>Authenticated</dt>
        <dd>@User.Identity?.IsAuthenticated</dd>
    </dl>

    <hr />

    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()

        <button type="submit">
            Logout
        </button>

    </form>
</div>